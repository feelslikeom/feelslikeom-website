---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Journeys | Feels Like Om</title>
    <meta name="description" content="Explore Feels Like Om journeys in Sikkim." />
    <link rel="stylesheet" href="/type-system.css" />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <nav class="main-nav" aria-label="Main navigation">
        <details class="nav-dropdown">
          <summary>ABOUT</summary>
          <div class="submenu">
            <a href="/about/our-story">Our story</a>
            <a href="/about/getting-to-sikkim">Getting to Sikkim</a>
            <a href="/about/visa-and-permits">Visa and permits</a>
          </div>
        </details>
        <details class="nav-dropdown">
          <summary class="active">JOURNEYS</summary>
          <div class="submenu">
            <a href="/journeys/the-flagship">The Flagship</a>
            <a href="/journeys/how-to-embrace-suffering">To Be Free</a>
            <a href="/journeys#feels-like-home">Feels Like Home</a>
            <a href="/journeys#way-of-the-yaks">Way of the Yaks</a>
          </div>
        </details>
        <a href="/reflections">REFLECTIONS</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow">JOURNEYS</p>
          <h1>Come live a little differently.</h1>
          <p class="intro">Slow down, make space for yourself, and learn from the land and its people.</p>
        </div>
      </section>

      <nav class="journey-tabs" aria-label="Journey options">
        <a class="journey-tab" href="/journeys/the-flagship">The Flagship</a>
      </nav>

      <section class="journey-preview">
        <a class="image-placeholder" href="/journeys/the-flagship" aria-label="Explore The Flagship">
          <span>Flagship photograph</span>
        </a>
        <div class="preview-copy">
          <p class="meta">West Sikkim | Field Immersion | 4D3N Trek</p>
          <h2>The Flagship</h2>
          <p>The Flagship is my firstborn, the essence of Feels Like Om. Equal parts community immersion and time in the mountains.</p>
          <a class="text-link" href="/journeys/the-flagship">Explore The Flagship <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { margin: 0; background: #f4efe5; color: #18301f; }
  .site-header { display:flex; justify-content:space-between; align-items:center; gap:2rem; padding:1.4rem 4%; border-bottom:1px solid rgba(24,48,31,.12); }
  .brand { color:inherit; text-decoration:none; }
  .main-nav { display:flex; align-items:center; gap:1.5rem; letter-spacing:.08em; }
  .main-nav > a,.main-nav summary { color:inherit; text-decoration:none; cursor:pointer; }
  .main-nav .active { border-bottom:1px solid currentColor; }
  .nav-dropdown { position:relative; }
  summary { list-style:none; }
  summary::-webkit-details-marker { display:none; }
  .submenu { position:absolute; top:calc(100% + .65rem); right:0; min-width:13rem; width:max-content; padding:.7rem; background:rgba(244,239,229,.98); box-shadow:0 12px 30px rgba(8,20,12,.14); opacity:0; visibility:hidden; transform:translateY(-4px); transition:opacity 160ms ease,visibility 160ms ease,transform 160ms ease; z-index:10; }
  .submenu::before { content:""; position:absolute; top:-.75rem; left:0; right:0; height:.75rem; }
  @media (hover:hover) {
    .nav-dropdown:hover .submenu { opacity:1; visibility:visible; transform:translateY(0); }
    .nav-dropdown:not(:hover) .submenu { opacity:0; visibility:hidden; transform:translateY(-4px); }
  }
  .submenu a { display:block; padding:.65rem .75rem; color:#18301f; text-decoration:none; letter-spacing:0; }
  .submenu a:hover { background:rgba(24,48,31,.06); }
  .hero { padding: clamp(6rem, 13vw, 11rem) 4% clamp(4rem, 8vw, 7rem); }
  .hero-inner { width:min(1100px,100%); margin:0 auto; }
  .eyebrow,.meta { letter-spacing:.12em; text-transform:uppercase; }
  h1 { max-width:900px; margin:.7rem 0 1.5rem; line-height:.98; }
  .intro { max-width:650px; line-height:1.6; }
  .journey-tabs { width:min(1100px,92%); margin:0 auto; display:flex; gap:1rem; border-top:1px solid rgba(24,48,31,.18); border-bottom:1px solid rgba(24,48,31,.18); padding:1rem 0; }
  .journey-tab { color:inherit; text-decoration:none; }
  .journey-preview { width:min(1100px,92%); margin:0 auto; padding:clamp(4rem,8vw,8rem) 0; display:grid; grid-template-columns:1.15fr .85fr; gap:clamp(2rem,6vw,6rem); align-items:center; }
  .image-placeholder { aspect-ratio:4/3; display:flex; align-items:center; justify-content:center; color:rgba(24,48,31,.58); text-decoration:none; background:linear-gradient(145deg,rgba(24,48,31,.12),rgba(24,48,31,.035)); border:1px solid rgba(24,48,31,.12); }
  .preview-copy h2 { margin:.5rem 0 1rem; }
  .preview-copy p { line-height:1.7; }
  .text-link { display:inline-block; margin-top:1rem; color:inherit; text-decoration:none; }
  @media (max-width:760px) {
    .site-header { align-items:flex-start; flex-direction:column; }
    .main-nav { width:100%; overflow:visible; gap:1rem; flex-wrap:wrap; }
    .submenu { right:auto; left:0; }
    .nav-dropdown[open] .submenu { opacity:1; visibility:visible; transform:translateY(0); }
    .journey-preview { grid-template-columns:1fr; }
  }
</style>

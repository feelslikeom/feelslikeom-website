---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>The Flagship Hero Preview | Feels Like Om</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="/about/our-story">ABOUT</a>
        <a class="active" href="/journeys">JOURNEYS</a>
        <a href="/reflections">REFLECTIONS</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="flagship-title">
        <div class="hero-image" aria-hidden="true"></div>
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="hero-copy">
          <h1 id="flagship-title">The Flagship</h1>
          <p>West Sikkim <span aria-hidden="true">|</span> Field Immersion <span aria-hidden="true">|</span> 4D3N Trek</p>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { margin:0; font-family:"Helvetica Neue",Helvetica,Arial,sans-serif; background:#18301f; }
  .site-header {
    position:absolute;
    z-index:5;
    inset:0 0 auto 0;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:2rem;
    padding:1.5rem 4%;
    color:#fff;
  }
  .brand { color:inherit; text-decoration:none; font-family:Georgia,serif; font-size:1.3rem; }
  .main-nav { display:flex; gap:1.5rem; font-size:.8rem; letter-spacing:.08em; }
  .main-nav a { color:inherit; text-decoration:none; }
  .main-nav .active { border-bottom:1px solid currentColor; }
  .hero {
    position:relative;
    min-height:100svh;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#f4efe5;
  }
  .hero-image {
    position:absolute;
    inset:0;
    background-image:url('/flagship-hero.jpg');
    background-size:cover;
    background-position:center center;
    transform:scale(1.01);
  }
  .hero-overlay {
    position:absolute;
    inset:0;
    background:linear-gradient(90deg,rgba(7,18,11,.14) 0%,rgba(7,18,11,.26) 52%,rgba(7,18,11,.28) 100%);
  }
  .hero-copy {
    position:relative;
    z-index:2;
    width:min(760px,54vw);
    margin-left:30vw;
    text-align:center;
    transform:translateY(1.5rem);
    text-shadow:0 2px 18px rgba(0,0,0,.28);
  }
  .hero h1 {
    margin:0;
    font-family:Georgia,serif;
    font-weight:400;
    font-size:clamp(4.5rem,8.5vw,9rem);
    line-height:.95;
    letter-spacing:-.025em;
  }
  .hero p {
    margin:2rem 0 0;
    font-size:clamp(1rem,1.55vw,1.45rem);
    line-height:1.5;
    letter-spacing:.025em;
  }
  @media (max-width:800px) {
    .site-header { align-items:flex-start; flex-direction:column; }
    .main-nav { width:100%; overflow-x:auto; gap:1rem; }
    .hero-image { background-position:38% center; }
    .hero-overlay { background:linear-gradient(0deg,rgba(7,18,11,.42),rgba(7,18,11,.08) 60%); }
    .hero-copy {
      width:min(92%,620px);
      margin:0;
      padding:0 5%;
      align-self:flex-end;
      padding-bottom:12vh;
      transform:none;
    }
    .hero h1 { font-size:clamp(3.6rem,17vw,6.5rem); }
    .hero p { font-size:.95rem; }
  }
</style>
  .hero::before { content:""; position:absolute; inset:0; background:linear-gradient(110deg,rgba(8,20,12,.12),rgba(8,20,12,.42)); }
  .hero-overlay { position:absolute; inset:0; background:linear-gradient(0deg,rgba(7,18,11,.58),rgba(7,18,11,.02) 65%); }

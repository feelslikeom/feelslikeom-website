  .hero-cta { margin-top:1.35rem; background:transparent; color:#f4efe5; border-color:#f4efe5; }
  .hero-cta:hover,.hero-cta:focus-visible { background:#f4efe5; color:#18301f; border-color:#f4efe5; }
  .opening-quote { width:100%; padding:clamp(5rem,9vw,8rem) 4%; text-align:center; }

  .audience-grid article > span { grid-column:1; font-size:var(--type-small); letter-spacing:.12em; opacity:.6; }
  .audience-grid article > h3 { grid-column:1; margin:.8rem 0 0; max-width:300px; }
  .audience-grid article > p { grid-column:2; margin:0 0 1rem; }

  .teacher-section { width:min(1200px,92%); margin:0 auto; padding:clamp(6rem,11vw,10rem) 0; display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(3rem,7vw,7rem); align-items:center; }
  .teacher-copy h2 { margin:.7rem 0 2rem; line-height:1.03; }
  .teacher-copy h2 span { display:block; font-size:.55em; margin-top:.7rem; }
  .teacher-copy blockquote { margin:0 0 1.75rem; font-size:var(--type-subheading)!important; line-height:1.2; }
  .teacher-copy p { margin:0 0 1rem; }
  .teacher-pull { margin:2rem 0!important; font-family:var(--font-display)!important; font-size:var(--type-subheading)!important; line-height:1.2!important; }

  .image-placeholder { display:flex; align-items:center; justify-content:center; min-height:260px; background:linear-gradient(145deg,rgba(24,48,31,.18),rgba(24,48,31,.05)); border:1px solid rgba(24,48,31,.14); color:rgba(24,48,31,.58); text-align:center; padding:1rem; }
  .program-intro .image-placeholder { background:rgba(244,239,229,.08); border-color:rgba(244,239,229,.22); color:rgba(244,239,229,.55); }
  .tall { min-height:660px; }

  .rhythm { background:#f4efe5; color:#18301f; }
  .journey-intro { width:min(850px,100%); margin:0 0 clamp(5rem,9vw,8rem); }
  .journey-intro ul { line-height:1.8; }
  .days-grid { display:block; }
  .retreat-days article { display:grid; grid-template-columns:minmax(230px,36%) minmax(0,64%); column-gap:clamp(2.5rem,6vw,6rem); padding:clamp(2.8rem,5vw,4.5rem) 0; }
  .retreat-days article > span { grid-column:1; margin:0 0 .75rem; font-size:var(--type-small); letter-spacing:.1em; text-transform:uppercase; opacity:.68; }
  .retreat-days article > h3 { grid-column:1; margin:0; max-width:320px; }
  .retreat-days .day-detail { grid-column:2; grid-row:1 / span 2; padding-left:clamp(2rem,4vw,4rem); border-left:1px solid rgba(24,48,31,.38); }

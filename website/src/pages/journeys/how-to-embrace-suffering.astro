  .section-nav-dot { order:2; flex:0 0 auto; width:8px; height:8px; border-radius:50%; background:#18301f; opacity:.8; box-shadow:0 0 0 2px rgba(244,239,229,.55); }
  .section-nav-label { order:1; flex:1 1 auto; opacity:0; transform:translateX(6px); text-align:right; font-size:.78rem; transition:opacity 180ms ease,transform 180ms ease; }
  .section-nav:hover .section-nav-label,.section-nav:focus-within .section-nav-label { opacity:1; transform:translateX(0); }

  .hero { position:relative; min-height:96svh; display:flex; align-items:flex-end; overflow:hidden; color:#f4efe5; background:radial-gradient(circle at 70% 25%,rgba(244,239,229,.13),transparent 34%),linear-gradient(145deg,#233d2a,#102217 68%); }
  .hero::before { content:""; position:absolute; inset:0; background:linear-gradient(110deg,rgba(8,20,12,.12),rgba(8,20,12,.42)); }
  .hero-overlay { position:absolute; inset:0; background:linear-gradient(0deg,rgba(7,18,11,.58),rgba(7,18,11,.02) 65%); }
  .hero-copy { position:relative; z-index:2; width:100%; padding:0 4% clamp(3.2rem,6vw,5.6rem); text-align:right; }
  .eyebrow { margin:0 0 .7rem; letter-spacing:.12em; text-transform:uppercase; }
  .eyebrow.dark { color:#18301f; }
  .hero h1 { margin:0 0 .85rem auto; max-width:1050px; line-height:.94; }
  .hero-line { margin:.2rem 0 1.5rem; font-family:var(--font-display)!important; font-size:var(--type-subheading)!important; }
  .hero-meta { width:max-content; max-width:100%; margin-left:auto; display:grid; gap:.15rem; }
  .hero-meta p { margin:0; }
  .hero-cta { margin-top:1.35rem; background:rgba(244,239,229,.05); }
  .hero-cta:hover { background:#f4efe5; color:#18301f; }

  .button { display:inline-block; padding:.9rem 1.2rem; border:1px solid currentColor; color:inherit; text-decoration:none; font-family:var(--font-display); transition:background 180ms ease,color 180ms ease; }

  .opening-quote { width:100%; padding:clamp(5rem,9vw,8rem) 4%; text-align:center; }
  .opening-quote blockquote { width:min(1000px,92%); margin:0 auto; line-height:1.08; font-weight:400; }
  .opening-quote cite { display:block; margin-top:1.5rem; font-family:var(--font-display); font-size:.72em; font-style:normal; text-align:right; }

  .program-intro { background:#18301f; color:#f4efe5; padding:clamp(5rem,10vw,9rem) 4%; }
  .program-intro-inner { width:min(1200px,100%); margin:0 auto; display:grid; gap:clamp(5rem,10vw,9rem); }
  .program-images { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(230px,.6fr); gap:clamp(1rem,3vw,2.25rem); align-items:end; }
  .program-image-large { min-height:clamp(360px,46vw,600px); }
  .program-image-small { min-height:clamp(240px,28vw,370px); margin-bottom:-2rem; }
  .intent-copy { max-width:620px; }
  .intent-copy p { margin:.35rem 0; }
  .intent-left { justify-self:start; text-align:left; }
  .intent-right { justify-self:end; text-align:right; }
  .intent-center { justify-self:center; text-align:center; max-width:850px; }
  .present-word { font-family:var(--font-display)!important; font-size:var(--type-section)!important; line-height:1!important; margin:1rem 0!important; }

  .section { padding:clamp(5rem,10vw,9rem) 4%; }
  .wide { width:min(1200px,100%); margin:0 auto; }
  .narrow { width:min(780px,100%); margin:0 auto; }
  .center { text-align:center; }
  .section h2 { margin:0 0 clamp(2.5rem,5vw,4rem); line-height:1.03; }

  .who-section { background:#f4efe5; }
  .who-summary { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin:0 0 clamp(5rem,8vw,7rem); padding:2rem 0; border-top:1px solid rgba(24,48,31,.2); border-bottom:1px solid rgba(24,48,31,.2); }
  .who-summary p { margin:0; font-family:var(--font-display)!important; font-size:clamp(1.3rem,2vw,1.8rem)!important; line-height:1.25; }

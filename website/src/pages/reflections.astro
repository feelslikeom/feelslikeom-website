<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Reflections | Feels Like Om</title>
    <link rel="stylesheet" href="/type-system.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <nav class="main-nav" aria-label="Main navigation">
        <details class="nav-dropdown">
          <summary>ABOUT</summary>
          <div class="submenu">
            <a href="/about/our-stories">Our stories</a>
            <a href="/about/getting-to-sikkim">Getting to Sikkim</a>
            <a href="/about/visa-and-permits">Visa and permits</a>
          </div>
        </details>
        <details class="nav-dropdown">
          <summary>JOURNEYS</summary>
          <div class="submenu">
            <a href="/journeys/the-flagship">The Flagship</a>
            <a href="/journeys/how-to-embrace-suffering">To Be Free</a>
            <a href="/journeys#feels-like-home">Feels Like Home</a>
            <a href="/journeys#way-of-the-yaks">Way of the Yaks</a>
          </div>
        </details>
        <a class="active" href="/reflections" aria-current="page">REFLECTIONS</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section>
        <p class="eyebrow">REFLECTIONS</p>
        <h1>Stories from past participants</h1>
        <p class="intro">This page will hold the post-program reflections shared by people who have journeyed with us.</p>

        <div class="reflection-list">
          <article id="participant-1"><h2>Participant reflection</h2><p>Reflection coming soon.</p></article>
          <article id="participant-2"><h2>Participant reflection</h2><p>Reflection coming soon.</p></article>
          <article id="participant-3"><h2>Participant reflection</h2><p>Reflection coming soon.</p></article>
        </div>
      </section>

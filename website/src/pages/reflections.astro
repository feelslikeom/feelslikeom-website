  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { margin: 0; background: #f4efe5; color: #18301f; }

  .site-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:2rem;
    padding:1.5rem 4%;
    border-bottom:1px solid rgba(24,48,31,.15);
  }
  .brand { color:inherit; text-decoration:none; white-space:nowrap; }
  .main-nav { display:flex; align-items:center; gap:1.5rem; letter-spacing:.08em; }
  .main-nav > a,
  .main-nav summary { color:inherit; text-decoration:none; cursor:pointer; }
  .main-nav .active { border-bottom:1px solid currentColor; }
  .nav-dropdown { position:relative; }
  .nav-dropdown summary { list-style:none; }
  .nav-dropdown summary::-webkit-details-marker { display:none; }
  .submenu {
    position:absolute;
    top:calc(100% + .65rem);
    right:0;
    width:max-content;
    min-width:13rem;
    padding:.7rem;
    background:#fffaf1;
    border-radius:.4rem;
    box-shadow:0 12px 30px rgba(8,20,12,.13);
    z-index:5;
    opacity:0;
    visibility:hidden;
    transform:translateY(-4px);
    transition:opacity 160ms ease,visibility 160ms ease,transform 160ms ease;
  }
  .submenu::before { content:""; position:absolute; top:-.75rem; left:0; right:0; height:.75rem; }
  .submenu a { display:block; padding:.65rem .75rem; color:#18301f; text-decoration:none; letter-spacing:0; }
  .submenu a:hover { background:rgba(24,48,31,.06); }
  @media (hover:hover) and (pointer:fine) {
    .nav-dropdown:hover .submenu { opacity:1; visibility:visible; transform:translateY(0); }
  }

  main { width: min(1100px, calc(100% - 2.5rem)); margin: 0 auto; padding: 0 0 7rem; }
  section { padding-top: clamp(4rem, 10vw, 8rem); }
  .eyebrow { margin: 0 0 1rem; letter-spacing: 0.14em; }
  h1 { margin: 0 0 1.5rem; line-height: 0.98; }
  .intro { max-width: 42rem; margin: 0 0 5rem; line-height: 1.7; }
  .reflection-list { display: grid; gap: 1px; background: rgba(24,48,31,.18); }
  article { background: #f4efe5; padding: 2.5rem 0; }
  article h2 { margin: 0 0 .75rem; }
  article p { margin: 0; }

  @media (max-width:760px) {
    .site-header { align-items:flex-start; padding:1.15rem 1.25rem; }
    .main-nav { gap:.75rem; flex-wrap:wrap; justify-content:flex-end; }
    .submenu { right:auto; left:0; }
    .nav-dropdown[open] .submenu { opacity:1; visibility:visible; transform:translateY(0); }
  }
</style>

---
const reflections = [
  {
    quote: "Sikkim has shown me how community and relationships are indeed the greatest currency in life.",
    name: "Amos",
    image: "/amos.jpg",
    focus: "50% 34%",
  },
  {
    quote: "Community. Realising that choosing to love with a genuine heart is something that no riches can buy.",
    name: "Bing Ming",
    image: "/bingming.jpg",
    focus: "50% 28%",
  },
  {
    quote: "A simple life being contented and intentional, focused lesser on what we do, but who we are and the good impact we leave on this world.",
    name: "Heather",
    image: "/heather.jpg",
    focus: "50% 30%",
  },
  {
    quote: "Reflection coming soon.",
    name: "Kwan Wei",
    image: "/kwanwei.jpg",
    focus: "50% 26%",
  },
  {
    quote: "Reflection coming soon.",
    name: "Li Yan",
    image: "/liyan.jpg",
    focus: "50% 28%",
  },
  {
    quote: "Reflection coming soon.",
    name: "Mirza",
    image: "/mirza.jpg",
    focus: "50% 30%",
  },
  {
    quote: "You’re honouring the reciprocal relationship between nature and humans. The way everyone lives has such intentionality, in spirit, emotion, body and mind.",
    name: "Tangen",
    image: "/tangen.jpg",
    focus: "50% 28%",
  },
  ...Array.from({ length: 11 }, () => ({
    quote: "Reflection coming soon.",
    name: "Past participant",
    image: "",
    focus: "50% 35%",
  })),
];

const baseWidth = 1180;
const baseHeight = 900;
const extraRings = Math.max(0, Math.ceil((reflections.length - 18) / 12));
const webWidth = baseWidth + extraRings * 260;
const webHeight = baseHeight + extraRings * 200;
const centre = { x: webWidth / 2, y: webHeight / 2 };

const reflectionNodes = reflections.map((reflection, index) => {
  const ring = index < 6 ? 0 : 1 + Math.floor((index - 6) / 12);
  const ringStart = ring === 0 ? 0 : 6 + (ring - 1) * 12;
  const remaining = reflections.length - ringStart;
  const ringCount = Math.min(ring === 0 ? 6 : 12, remaining);
  const position = index - ringStart;
  const angleOffset = ring % 2 === 0 ? -Math.PI / 2 : -Math.PI / 2 + 0.12;
  const angle = angleOffset + (position / ringCount) * Math.PI * 2;
  const radiusX = 250 + ring * 160;
  const radiusY = 190 + ring * 140;
  const wobble = ((index % 5) - 2) * 7;

  return {
    ...reflection,
    ring,
    position,
    ringCount,
    x: centre.x + Math.cos(angle) * (radiusX + wobble),
    y: centre.y + Math.sin(angle) * (radiusY - wobble * 0.45),
    size: 62 + (index % 4) * 7,
  };
});

const curvePath = (a, b, bend = 0.1) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const length = Math.max(1, Math.hypot(dx, dy));
  const offset = length * bend;
  const cx = mx - (dy / length) * offset;
  const cy = my + (dx / length) * offset;
  return `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
};

const webPaths = [];
const rings = Array.from({ length: extraRings + 2 }, (_, ringIndex) => reflectionNodes.filter((node) => node.ring === ringIndex)).filter((ring) => ring.length);

rings.forEach((ringNodes, ringIndex) => {
  ringNodes.forEach((node, index) => {
    if (ringNodes.length > 1) {
      const next = ringNodes[(index + 1) % ringNodes.length];
      webPaths.push(curvePath(node, next, index % 2 ? 0.07 : -0.07));
    }
    if (ringNodes.length > 5) {
      const skip = ringNodes[(index + 2) % ringNodes.length];
      webPaths.push(curvePath(node, skip, index % 3 === 0 ? 0.11 : -0.08));
    }
    if (ringIndex > 0 && rings[ringIndex - 1]?.length) {
      const innerRing = rings[ringIndex - 1];
      const inner = innerRing[Math.round((index / ringNodes.length) * innerRing.length) % innerRing.length];
      webPaths.push(curvePath(node, inner, index % 2 ? 0.08 : -0.09));
    }
    if (index % 4 === 0) {
      webPaths.push(curvePath(node, centre, index % 2 ? 0.08 : -0.08));
    }
  });
});
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Reflections | Feels Like Om</title>
    <link rel="stylesheet" href="/type-system.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <nav class="main-nav" aria-label="Main navigation">
        <details class="nav-dropdown">
          <summary>ABOUT</summary>
          <div class="submenu">
            <a href="/about/our-stories">Our stories</a>
            <a href="/about/getting-to-sikkim">Getting to Sikkim</a>
            <a href="/about/visa-and-permits">Visa and permits</a>
          </div>
        </details>
        <details class="nav-dropdown">
          <summary>JOURNEYS</summary>
          <div class="submenu">
            <a href="/journeys/the-flagship">The Flagship</a>
            <a href="/journeys/how-to-embrace-suffering">To Be Free</a>
            <a href="/journeys#feels-like-home">Feels Like Home</a>
            <a href="/journeys#way-of-the-yaks">Way of the Yaks</a>
          </div>
        </details>
        <a class="active" href="/reflections" aria-current="page">REFLECTIONS</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section class="reflection-intro">
        <p class="eyebrow">REFLECTIONS</p>
        <h1>We are all connected.</h1>
        <p class="intro">Each circle holds one person’s reflection. Follow the threads, click into a story, and move from one reflection to the next.</p>
      </section>

      <section class="reflection-web-section" aria-label="Interconnected participant reflections">
        <div class="reflection-web-scroller">
          <div class="reflection-web" style={`--web-width:${webWidth}px;--web-height:${webHeight}px;`}>
            <svg class="web-lines" viewBox={`0 0 ${webWidth} ${webHeight}`} aria-hidden="true">
              <g class="web-ring">
                {webPaths.map((path) => <path d={path} />)}
              </g>
            </svg>

            <div class="flo-center" aria-label="Feels Like Om">
              <img src="/Logo-Circle.png" alt="Feels Like Om circular logo" />
            </div>

            {reflectionNodes.map((reflection, index) => (
              <button
                class={`reflection-node${reflection.image ? " has-image" : ""}`}
                type="button"
                style={`--x:${reflection.x}px;--y:${reflection.y}px;--node-size:${reflection.size}px;--image:${reflection.image ? `url('${reflection.image}')` : "none"};--focus:${reflection.focus};`}
                data-index={index}
                data-quote={reflection.quote}
                data-name={reflection.name}
                data-image={reflection.image}
                data-focus={reflection.focus}
                aria-label={`Open reflection from ${reflection.name}`}
              >
                <span aria-hidden="true"></span>
              </button>
            ))}
          </div>
        </div>
      </section>
    </main>

    <dialog class="reflection-lightbox" aria-label="Participant reflection">
      <button class="lightbox-close" type="button" aria-label="Close reflection">×</button>
      <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous reflection">‹</button>
      <button class="lightbox-nav lightbox-next" type="button" aria-label="Next reflection">›</button>
      <div class="lightbox-copy">
        <blockquote class="lightbox-quote">“Reflection coming soon.”</blockquote>
        <p class="lightbox-name">— Past participant</p>
      </div>
      <div class="lightbox-image" aria-label="Participant reflection image">
        <img class="lightbox-photo" alt="" />
        <span class="lightbox-placeholder">Reflection image</span>
      </div>
    </dialog>

    <script>
      const nodes = Array.from(document.querySelectorAll('.reflection-node'));
      const dialog = document.querySelector('.reflection-lightbox');
      const quote = dialog?.querySelector('.lightbox-quote');
      const name = dialog?.querySelector('.lightbox-name');
      const photo = dialog?.querySelector('.lightbox-photo');
      const placeholder = dialog?.querySelector('.lightbox-placeholder');
      const close = dialog?.querySelector('.lightbox-close');
      const prev = dialog?.querySelector('.lightbox-prev');
      const next = dialog?.querySelector('.lightbox-next');
      let current = 0;

      const showReflection = (index) => {
        if (!nodes.length || !dialog) return;
        current = (index + nodes.length) % nodes.length;
        const node = nodes[current];
        const image = node.dataset.image ?? '';
        if (quote) quote.textContent = `“${node.dataset.quote ?? ''}”`;
        if (name) name.textContent = `— ${node.dataset.name ?? ''}`;
        if (photo) {
          if (image) {
            photo.src = image;
            photo.alt = `${node.dataset.name ?? 'Participant'} reflection photograph`;
            photo.style.objectPosition = node.dataset.focus ?? '50% 35%';
            photo.hidden = false;
          } else {
            photo.removeAttribute('src');
            photo.hidden = true;
          }
        }
        if (placeholder) placeholder.hidden = Boolean(image);
        if (!dialog.open) dialog.showModal();
      };

      nodes.forEach((node, index) => node.addEventListener('click', () => showReflection(index)));
      close?.addEventListener('click', () => dialog?.close());
      prev?.addEventListener('click', () => showReflection(current - 1));
      next?.addEventListener('click', () => showReflection(current + 1));
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      document.addEventListener('keydown', (event) => {
        if (!dialog?.open) return;
        if (event.key === 'ArrowLeft') showReflection(current - 1);
        if (event.key === 'ArrowRight') showReflection(current + 1);
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing:border-box; }
  body { margin:0; background:#f4efe5; color:#18301f; overflow-x:hidden; }

  .site-header { display:flex; align-items:center; justify-content:space-between; gap:2rem; padding:1.5rem 4%; border-bottom:1px solid rgba(24,48,31,.15); }
  .brand { color:inherit; text-decoration:none; white-space:nowrap; }
  .main-nav { display:flex; align-items:center; gap:1.5rem; letter-spacing:.08em; }
  .main-nav>a,.main-nav summary { color:inherit; text-decoration:none; cursor:pointer; }
  .main-nav .active { border-bottom:1px solid currentColor; }
  .nav-dropdown { position:relative; }
  .nav-dropdown summary { list-style:none; }
  .nav-dropdown summary::-webkit-details-marker { display:none; }
  .submenu { position:absolute; top:calc(100% + .65rem); right:0; width:max-content; min-width:13rem; padding:.7rem; background:#fffaf1; border-radius:.4rem; box-shadow:0 12px 30px rgba(8,20,12,.13); z-index:8; opacity:0; visibility:hidden; transform:translateY(-4px); transition:opacity 160ms ease,visibility 160ms ease,transform 160ms ease; }
  .submenu::before { content:""; position:absolute; top:-.75rem; left:0; right:0; height:.75rem; }
  .submenu a { display:block; padding:.65rem .75rem; color:#18301f; text-decoration:none; letter-spacing:0; }
  .submenu a:hover { background:rgba(24,48,31,.06); }
  @media (hover:hover) and (pointer:fine) { .nav-dropdown:hover .submenu { opacity:1; visibility:visible; transform:translateY(0); } }

  main { width:100%; }
  .reflection-intro { width:min(1180px,calc(100% - 8%)); margin:0 auto; padding:clamp(5rem,10vw,8rem) 0 1rem; text-align:center; }
  .eyebrow { margin:0 0 1.2rem; letter-spacing:.14em; }
  .reflection-intro h1 { margin:0; font-size:clamp(3rem,6vw,6.5rem)!important; line-height:.98; }
  .intro { width:min(620px,100%); margin:1.5rem auto 0; line-height:1.7; }

  .reflection-web-section { width:100%; padding:clamp(2rem,5vw,4rem) 0 clamp(5rem,9vw,8rem); overflow:hidden; }
  .reflection-web-scroller { width:100%; overflow-x:auto; overflow-y:hidden; scrollbar-width:thin; scrollbar-color:rgba(24,48,31,.24) transparent; }
  .reflection-web { position:relative; width:var(--web-width); height:var(--web-height); margin:0 auto; }
  .web-lines { position:absolute; inset:0; width:100%; height:100%; overflow:visible; pointer-events:none; }
  .web-ring { fill:none; stroke:#18301f; stroke-width:1.15; opacity:.34; stroke-linecap:round; stroke-linejoin:round; }

  .flo-center { position:absolute; left:50%; top:50%; width:clamp(120px,17vw,210px); aspect-ratio:1; transform:translate(-50%,-50%); border-radius:50%; overflow:hidden; background:transparent; border:0; box-shadow:none; z-index:3; }
  .flo-center img { display:block; width:100%; height:100%; object-fit:contain; border-radius:50%; }

  .reflection-node { position:absolute; left:var(--x); top:var(--y); width:var(--node-size); aspect-ratio:1; transform:translate(-50%,-50%); border-radius:50%; border:2px solid #18301f; padding:0; cursor:zoom-in; background:#f4efe5; z-index:4; overflow:hidden; transition:transform 180ms ease,box-shadow 180ms ease; }
  .reflection-node span { display:block; width:100%; height:100%; border-radius:50%; background:linear-gradient(145deg,rgba(24,48,31,.24),rgba(24,48,31,.06)); }
  .reflection-node.has-image span { background-image:var(--image); background-size:cover; background-position:var(--focus); background-repeat:no-repeat; }
  .reflection-node:hover,.reflection-node:focus-visible { transform:translate(-50%,-50%) scale(1.12); box-shadow:0 10px 25px rgba(24,48,31,.16); outline:none; }

  .reflection-lightbox { width:min(92vw,940px); max-width:940px; max-height:92vh; padding:clamp(1.5rem,3vw,2.5rem); border:0; background:#f4efe5; color:#18301f; box-shadow:0 24px 70px rgba(7,18,11,.34); overflow:auto; }
  .reflection-lightbox::backdrop { background:rgba(7,18,11,.78); backdrop-filter:blur(4px); }
  .lightbox-copy { text-align:center; margin:0 auto clamp(1.5rem,3vw,2.5rem); max-width:780px; }
  .lightbox-quote { margin:0 0 .65rem; font-size:clamp(1.71rem,3.04vw,3.04rem)!important; line-height:1.08; }
  .lightbox-name { margin:0; opacity:.72; }
  .lightbox-image { width:min(720px,100%); min-height:0; height:min(58vh,620px); margin:0 auto; display:flex; align-items:center; justify-content:center; overflow:hidden; background:linear-gradient(145deg,rgba(24,48,31,.16),rgba(24,48,31,.035)); border:1px solid rgba(24,48,31,.14); color:rgba(24,48,31,.5); }
  .lightbox-photo { display:block; width:100%; height:100%; object-fit:contain; background:#f4efe5; }
  .lightbox-photo[hidden],.lightbox-placeholder[hidden] { display:none; }
  .lightbox-close { position:sticky; top:0; float:right; width:2.7rem; height:2.7rem; margin:0 0 -2.7rem auto; border:0; border-radius:50%; background:rgba(255,250,241,.96); color:#18301f; font-size:1.8rem; cursor:pointer; z-index:6; }
  .lightbox-nav { position:fixed; top:50%; width:3.2rem; height:3.2rem; transform:translateY(-50%); border:1px solid rgba(24,48,31,.18); border-radius:50%; background:rgba(244,239,229,.96); color:#18301f; font-family:Georgia,serif; font-size:2.1rem; cursor:pointer; z-index:6; box-shadow:0 8px 24px rgba(7,18,11,.16); }
  .lightbox-prev { left:max(1rem,calc(50vw - 540px)); }
  .lightbox-next { right:max(1rem,calc(50vw - 540px)); }

  @media (max-width:760px) {
    .site-header { align-items:flex-start; padding:1.15rem 1.25rem; }
    .main-nav { gap:.75rem; flex-wrap:wrap; justify-content:flex-end; }
    .submenu { right:auto; left:0; }
    .nav-dropdown[open] .submenu { opacity:1; visibility:visible; transform:translateY(0); }
    .reflection-intro { width:calc(100% - 2.5rem); padding-top:4rem; }
    .reflection-web-scroller { padding-bottom:.5rem; }
    .reflection-web { margin-left:0; }
    .reflection-node { width:max(58px,calc(var(--node-size) * .86)); }
    .flo-center { width:150px; }
    .reflection-lightbox { width:96vw; max-height:94vh; padding:1.25rem .9rem 1rem; }
    .lightbox-image { width:100%; height:min(55vh,520px); }
    .lightbox-nav { width:2.7rem; height:2.7rem; font-size:1.7rem; }
    .lightbox-prev { left:.5rem; }
    .lightbox-next { right:.5rem; }
  }
</style>

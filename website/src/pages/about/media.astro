<style>
  :global(*){box-sizing:border-box}body{margin:0;background:#f4efe5;color:#18301f;overflow-x:hidden;font-family:var(--font-body)}a{color:inherit;text-underline-offset:.3rem}.wide{width:min(1180px,92%);margin:0 auto}
  .site-header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem 4%;border-bottom:1px solid rgba(24,48,31,.15)}.brand{color:inherit;text-decoration:none;white-space:nowrap}.main-nav{display:flex;align-items:center;gap:1.5rem;letter-spacing:.08em}.main-nav>a,.main-nav summary{color:inherit;text-decoration:none;cursor:pointer}.main-nav .active{border-bottom:1px solid currentColor}.nav-dropdown{position:relative}.nav-dropdown summary{list-style:none}.nav-dropdown summary::-webkit-details-marker{display:none}.submenu{position:absolute;top:calc(100% + .65rem);right:0;width:max-content;min-width:12rem;padding:.7rem;background:#fffaf1;box-shadow:0 12px 30px rgba(8,20,12,.13);z-index:10;opacity:0;visibility:hidden;transform:translateY(-4px);transition:.16s}.submenu a{display:block;padding:.65rem .75rem;color:#18301f;text-decoration:none;letter-spacing:0}.submenu a:hover{background:rgba(24,48,31,.06)}@media(hover:hover){.nav-dropdown:hover .submenu{opacity:1;visibility:visible;transform:translateY(0)}}
  .page-hero{padding:clamp(5rem,10vw,8rem) 0 clamp(3rem,6vw,5rem);text-align:center}.eyebrow{margin:0 0 1.2rem;letter-spacing:.14em}.page-hero h1{margin:0;font-family:var(--font-display);font-size:var(--type-display)!important;line-height:.98;font-weight:400}
  .feature-section{padding:0 4% clamp(7rem,12vw,10rem);display:grid;gap:clamp(6rem,10vw,9rem)}.feature-card{width:min(1080px,100%);margin:0 auto;padding:clamp(2rem,5vw,4rem);background:#fffaf1;border:1px solid rgba(24,48,31,.14);box-shadow:0 18px 50px rgba(24,48,31,.08)}.publication{margin:0 0 1.5rem;font-size:var(--type-small)!important;letter-spacing:.08em;text-transform:uppercase;opacity:.65}.feature-image-link{display:block;text-decoration:none}.feature-image{display:block;width:100%;height:auto;border:1px solid rgba(24,48,31,.12);transition:opacity 180ms ease}.feature-image-link:hover .feature-image{opacity:.94}.article-link{display:inline-flex;gap:.55rem;align-items:center;margin-top:1.5rem;font-family:var(--font-display);font-size:var(--type-cta);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.12rem}
  @media(max-width:760px){.site-header{align-items:flex-start;padding:1.15rem 1.25rem}.main-nav{gap:.75rem;flex-wrap:wrap;justify-content:flex-end}.submenu{right:auto;left:0}.nav-dropdown[open] .submenu{opacity:1;visibility:visible;transform:translateY(0)}.wide{width:calc(100% - 2.5rem)}.page-hero{padding-top:4rem}.feature-section{padding-left:1.25rem;padding-right:1.25rem;gap:4.5rem}.feature-card{padding:1.25rem}}
</style>

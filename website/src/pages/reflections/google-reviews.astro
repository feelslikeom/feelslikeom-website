---
const googleReviewsUrl = 'https://maps.app.goo.gl/6UmDnZoQGBAi7V2S7';
const reviewCards = [
  { name: 'Google reviewer', meta: 'View on Google', size: 'short' },
  { name: 'Google reviewer', meta: 'View on Google', size: 'tall' },
  { name: 'Google reviewer', meta: 'View on Google', size: 'short' },
  { name: 'Google reviewer', meta: 'View on Google', size: 'short' },
  { name: 'Google reviewer', meta: 'View on Google', size: 'short' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Google Reviews | Feels Like Om</title>
    <meta name="description" content="Read Google reviews from people who have experienced Feels Like Om journeys in Sikkim." />
    <link rel="stylesheet" href="/type-system.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <button class="mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="main-nav" aria-label="Main navigation">
        <details class="nav-dropdown"><summary>ABOUT</summary><div class="submenu"><a href="/about/our-stories">Our stories</a><a href="/about/getting-to-sikkim">Getting to Sikkim</a><a href="/about/visa-and-permits">Visa and permits</a><a href="/about/media">Media</a></div></details>
        <details class="nav-dropdown"><summary>JOURNEYS</summary><div class="submenu"><a href="/journeys/the-flagship">The Flagship</a><a href="/journeys/how-to-embrace-suffering">To Be Free</a></div></details>
        <details class="nav-dropdown"><summary class="active">REFLECTIONS</summary><div class="submenu"><a href="/reflections">Guest Book</a><a href="/reflections/google-reviews">Google Reviews</a><a href="/reflections/life-on-sikkim-time">Life on Sikkim time</a></div></details>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section class="page-hero">
        <div class="wide">
          <h1>Kind words from our community</h1>
          <div class="google-summary" aria-label="Google Reviews">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span>Google Reviews</span>
          </div>
        </div>
      </section>

      <section class="reviews-section" aria-label="Google reviews">
        <div class="reviews-shell">
          <div class="review-wall">
            <div class="review-column review-column--left">
              <a class="review-card" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
                <div class="review-head">
                  <div class="avatar" aria-hidden="true">G</div>
                  <div><strong>{reviewCards[0].name}</strong><span>{reviewCards[0].meta}</span></div>
                  <span class="google-mark" aria-hidden="true">G</span>
                </div>
                <div class="review-stars" aria-hidden="true">★★★★★</div>
                <p>Read this guest review on Google Maps.</p>
              </a>
              <a class="review-card review-card--compact" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
                <div class="review-head">
                  <div class="avatar" aria-hidden="true">G</div>
                  <div><strong>{reviewCards[3].name}</strong><span>{reviewCards[3].meta}</span></div>
                  <span class="google-mark" aria-hidden="true">G</span>
                </div>
                <div class="review-stars" aria-hidden="true">★★★★★</div>
                <p>Open Google to read the full review.</p>
              </a>
            </div>

            <div class="review-column review-column--centre">
              <a class="review-card review-card--feature" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
                <div class="review-head">
                  <div class="avatar" aria-hidden="true">G</div>
                  <div><strong>{reviewCards[1].name}</strong><span>{reviewCards[1].meta}</span></div>
                  <span class="google-mark" aria-hidden="true">G</span>
                </div>
                <div class="review-stars" aria-hidden="true">★★★★★</div>
                <p>Read the full guest reflection directly on Google Maps.</p>
              </a>
            </div>

            <div class="review-column review-column--right">
              <a class="review-card" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
                <div class="review-head">
                  <div class="avatar" aria-hidden="true">G</div>
                  <div><strong>{reviewCards[2].name}</strong><span>{reviewCards[2].meta}</span></div>
                  <span class="google-mark" aria-hidden="true">G</span>
                </div>
                <div class="review-stars" aria-hidden="true">★★★★★</div>
                <p>Read this guest review on Google Maps.</p>
              </a>
              <a class="review-card review-card--compact" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
                <div class="review-head">
                  <div class="avatar" aria-hidden="true">G</div>
                  <div><strong>{reviewCards[4].name}</strong><span>{reviewCards[4].meta}</span></div>
                  <span class="google-mark" aria-hidden="true">G</span>
                </div>
                <div class="review-stars" aria-hidden="true">★★★★★</div>
                <p>Open Google to read the full review.</p>
              </a>
            </div>
          </div>

          <div class="reviews-footer">
            <a class="reviews-link" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">Read all reviews on Google <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </main>

    <script src="/mobile-nav.js" is:inline></script>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  body{margin:0;background:#f4efe5;color:#18301f;overflow-x:hidden;font-family:var(--font-body)}
  a{color:inherit;text-underline-offset:.3rem}
  .wide{width:min(1180px,92%);margin:0 auto}
  .site-header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem 4%;border-bottom:1px solid rgba(24,48,31,.15)}
  .brand{color:inherit;text-decoration:none;white-space:nowrap}.main-nav{display:flex;align-items:center;gap:1.5rem;letter-spacing:.08em}.main-nav>a,.main-nav summary{color:inherit;text-decoration:none;cursor:pointer}.main-nav .active{border-bottom:1px solid currentColor}.nav-dropdown{position:relative}.nav-dropdown summary{list-style:none}.nav-dropdown summary::-webkit-details-marker{display:none}.submenu{position:absolute;top:calc(100% + .65rem);right:0;width:max-content;min-width:13rem;padding:.7rem;background:#fffaf1;box-shadow:0 12px 30px rgba(8,20,12,.13);z-index:10;opacity:0;visibility:hidden;transform:translateY(-4px);transition:.16s}.submenu a{display:block;padding:.65rem .75rem;color:#18301f;text-decoration:none;letter-spacing:0}.submenu a:hover{background:rgba(24,48,31,.06)}@media(hover:hover){.nav-dropdown:hover .submenu{opacity:1;visibility:visible;transform:translateY(0)}}

  .page-hero{padding:clamp(5.75rem,10vw,8.5rem) 0 clamp(2.25rem,4vw,3.25rem);text-align:center}
  .page-hero h1{margin:0 auto;font-family:var(--font-display);font-size:clamp(3.1rem,5.3vw,5.9rem)!important;line-height:.98;font-weight:400}
  .google-summary{display:flex;justify-content:center;align-items:center;gap:1rem;margin-top:1.65rem;font-size:1rem}
  .stars,.review-stars{letter-spacing:.08em;color:#bd7a05}

  .reviews-section{padding:0 4% clamp(7.5rem,11vw,10rem)}
  .reviews-shell{width:min(1220px,100%);margin:0 auto}
  .review-wall{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1.1rem;align-items:start}
  .review-column{display:grid;gap:1.1rem}
  .review-card{display:block;padding:1.45rem 1.55rem;background:#fffaf1;border:1px solid rgba(24,48,31,.08);box-shadow:0 10px 26px rgba(24,48,31,.035);text-decoration:none;transition:transform 180ms ease,box-shadow 180ms ease}
  .review-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(24,48,31,.07)}
  .review-card--feature{min-height:350px}
  .review-card--compact{min-height:180px}
  .review-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.8rem}
  .avatar{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#dbe2d9;color:#18301f;font-family:var(--font-display);font-size:1.1rem}
  .review-head strong{display:block;font-size:.95rem;font-weight:600}
  .review-head span:not(.google-mark){display:block;margin-top:.15rem;font-size:.78rem;opacity:.65}
  .google-mark{font-weight:700;font-size:1.2rem;color:#4285f4}
  .review-stars{margin-top:1rem;font-size:1rem}
  .review-card p{margin:.75rem 0 0;font-size:clamp(1rem,1.25vw,1.15rem);line-height:1.55}
  .review-card--feature p{font-size:clamp(1.15rem,1.5vw,1.35rem);line-height:1.6}
  .reviews-footer{display:flex;justify-content:center;padding-top:1.4rem}
  .reviews-link{display:inline-flex;align-items:center;gap:.7rem;padding:1rem 1.4rem;background:#18301f;color:#f4efe5;text-decoration:none;font-family:var(--font-body);font-size:1rem;transition:transform 180ms ease,opacity 180ms ease}
  .reviews-link:hover{transform:translateY(-1px);opacity:.94}

  @media(max-width:900px){.review-wall{grid-template-columns:1fr 1fr}.review-column--centre{grid-column:1/-1}.review-column--centre .review-card{min-height:0}.review-column--right{grid-column:2}}
  @media(max-width:760px){
    .site-header{align-items:flex-start;padding:1.15rem 1.25rem}.main-nav{gap:.75rem;flex-wrap:wrap;justify-content:flex-end}.submenu{right:auto;left:0}.nav-dropdown[open] .submenu{opacity:1;visibility:visible;transform:translateY(0)}
    .wide{width:calc(100% - 2.5rem)}.page-hero{padding:4.75rem 0 2.5rem}.page-hero h1{font-size:clamp(2.8rem,12vw,4.2rem)!important}.google-summary{flex-direction:column;gap:.45rem}
    .reviews-section{padding-left:1.25rem;padding-right:1.25rem}.review-wall{grid-template-columns:1fr}.review-column--centre,.review-column--right{grid-column:auto}.review-card,.review-card--feature,.review-card--compact{min-height:0;padding:1.2rem}.reviews-link{width:100%;justify-content:center;text-align:center}
  }
</style>

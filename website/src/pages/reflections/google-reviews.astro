<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Google Reviews | Feels Like Om</title>
    <meta name="description" content="Read Google reviews from people who have experienced Feels Like Om journeys in Sikkim." />
    <link rel="stylesheet" href="/type-system.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <button class="mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="main-nav" aria-label="Main navigation">
        <details class="nav-dropdown"><summary>ABOUT</summary><div class="submenu"><a href="/about/our-stories">Our stories</a><a href="/about/getting-to-sikkim">Getting to Sikkim</a><a href="/about/visa-and-permits">Visa and permits</a><a href="/about/media">Media</a></div></details>
        <details class="nav-dropdown"><summary>JOURNEYS</summary><div class="submenu"><a href="/journeys/the-flagship">The Flagship</a><a href="/journeys/how-to-embrace-suffering">To Be Free</a></div></details>
        <details class="nav-dropdown"><summary class="active">REFLECTIONS</summary><div class="submenu"><a href="/reflections">Guest Book</a><a href="/reflections/google-reviews">Google Reviews</a><a href="/reflections/life-on-sikkim-time">Life on Sikkim time</a></div></details>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section class="page-hero"><div class="wide"><p class="eyebrow">REFLECTIONS</p><h1>Google Reviews</h1><p class="intro">Read what guests have shared publicly about their experience with Feels Like Om.</p></div></section>
      <section class="reviews-section">
        <div class="reviews-shell">
          <div class="map-embed">
            <iframe title="Feels Like Om on Google Maps" src="https://www.google.com/maps?q=Feels%20Like%20Om&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <a class="reviews-link" href="https://maps.app.goo.gl/6UmDnZoQGBAi7V2S7" target="_blank" rel="noopener noreferrer">Read our reviews on Google <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
    <script src="/mobile-nav.js" is:inline></script>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}body{margin:0;background:#f4efe5;color:#18301f;overflow-x:hidden;font-family:var(--font-body)}a{color:inherit;text-underline-offset:.3rem}.wide{width:min(1180px,92%);margin:0 auto}.site-header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem 4%;border-bottom:1px solid rgba(24,48,31,.15)}.brand{color:inherit;text-decoration:none;white-space:nowrap}.main-nav{display:flex;align-items:center;gap:1.5rem;letter-spacing:.08em}.main-nav>a,.main-nav summary{color:inherit;text-decoration:none;cursor:pointer}.main-nav .active{border-bottom:1px solid currentColor}.nav-dropdown{position:relative}.nav-dropdown summary{list-style:none}.nav-dropdown summary::-webkit-details-marker{display:none}.submenu{position:absolute;top:calc(100% + .65rem);right:0;width:max-content;min-width:13rem;padding:.7rem;background:#fffaf1;box-shadow:0 12px 30px rgba(8,20,12,.13);z-index:10;opacity:0;visibility:hidden;transform:translateY(-4px);transition:.16s}.submenu a{display:block;padding:.65rem .75rem;color:#18301f;text-decoration:none;letter-spacing:0}.submenu a:hover{background:rgba(24,48,31,.06)}@media(hover:hover){.nav-dropdown:hover .submenu{opacity:1;visibility:visible;transform:translateY(0)}}.page-hero{padding:clamp(5rem,10vw,8rem) 0 clamp(3rem,6vw,5rem);text-align:center}.eyebrow{margin:0 0 1.2rem;letter-spacing:.14em}.page-hero h1{margin:0;font-family:var(--font-display);font-size:var(--type-display)!important;line-height:.98;font-weight:400}.intro{width:min(650px,100%);margin:1.4rem auto 0;line-height:1.7}.reviews-section{padding:0 4% clamp(7rem,12vw,10rem)}.reviews-shell{width:min(960px,100%);margin:0 auto;text-align:center}.map-embed{width:100%;aspect-ratio:16/9;overflow:hidden;background:#fffaf1;border:1px solid rgba(24,48,31,.14)}.map-embed iframe{width:100%;height:100%;border:0;display:block}.reviews-link{display:inline-flex;align-items:center;gap:.55rem;margin-top:2rem;font-family:var(--font-display);font-size:var(--type-cta);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.12rem}@media(max-width:760px){.site-header{align-items:flex-start;padding:1.15rem 1.25rem}.main-nav{gap:.75rem;flex-wrap:wrap;justify-content:flex-end}.submenu{right:auto;left:0}.nav-dropdown[open] .submenu{opacity:1;visibility:visible;transform:translateY(0)}.wide{width:calc(100% - 2.5rem)}.page-hero{padding-top:4rem}.reviews-section{padding-left:1.25rem;padding-right:1.25rem}.map-embed{aspect-ratio:4/5}}
</style>

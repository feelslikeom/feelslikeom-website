---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Feels Like Om</title>
  </head>

  <body>
    <main class="hero">
      <div class="overlay"></div>

      <div class="hero-content">
        <h1>Who you are matters.</h1>
        <p>Slow down. Listen to the land. Make space for yourself.</p>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Georgia, serif;
    background: #f4efe5;
    color: white;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    background: url('/hero-river.JPG') center / cover no-repeat;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8, 20, 12, 0.58) 0%,
        rgba(8, 20, 12, 0.22) 42%,
        rgba(8, 20, 12, 0.02) 68%
      );
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    top: 18%;
    left: 4%;
    z-index: 1;
    max-width: 92vw;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(3rem, 6vw, 6.5rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  p {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.4;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .hero {
      background-position: 62% center;
    }

    .overlay {
      background:
        linear-gradient(
          to bottom,
          rgba(8, 20, 12, 0.52) 0%,
          rgba(8, 20, 12, 0.16) 48%,
          rgba(8, 20, 12, 0.04) 72%
        );
    }

    .hero-content {
      top: 10%;
      left: 1.25rem;
      right: 1.25rem;
      max-width: none;
    }

    h1 {
      font-size: clamp(2.65rem, 13vw, 4.5rem);
      white-space: normal;
    }

    p {
      max-width: 28rem;
      font-size: 1.05rem;
      white-space: normal;
    }
  }
</style>

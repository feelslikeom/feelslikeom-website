---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Feels Like Om</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">Feels Like Om</a>
      <nav class="main-nav" aria-label="Main navigation">
        <details>
          <summary>ABOUT</summary>
          <div class="submenu">
            <a href="/about/our-story">Our story</a>
            <a href="/about/getting-to-sikkim">Getting to Sikkim</a>
            <a href="/about/visa-and-permits">Visa and permits</a>
          </div>
        </details>
        <a href="/journeys">JOURNEYS</a>
        <a href="/reflections">REFLECTIONS</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="overlay"></div>
        <div class="hero-content hero-reveal">
          <h1>Who you are matters.</h1>
          <p>
            Slow down.<br />
            Make space for yourself.<br />
            Learn from the land and its people.
          </p>
        </div>
        <div class="scroll-cue" aria-hidden="true">
          <span class="scroll-label">SCROLL</span>
          <span class="scroll-line"><span></span></span>
        </div>
      </section>

      <section class="people" aria-labelledby="people-heading">
        <div class="people-inner">
          <h2 id="people-heading" class="reveal">The people behind Feels Like Om</h2>

          <div class="founders-grid">
            <article class="founder-card reveal">
              <div class="portrait-wrap">
                <img src="/zi-hui.JPG" alt="Zi Hui walking through a village in Sikkim" />
              </div>
              <div class="founder-copy">
                <p class="person-name">Zi Hui</p>
                <blockquote>“A tree helped me forgive myself.”</blockquote>
                <a class="story-link" href="/about/our-story#zi-hui">Read Zi Hui’s story <span aria-hidden="true">→</span></a>
              </div>
            </article>

            <article class="founder-card founder-card--placeholder reveal" aria-label="Elan profile coming next">
              <div class="portrait-wrap portrait-wrap--placeholder" aria-hidden="true"></div>
              <div class="founder-copy">
                <p class="person-name">Elan</p>
                <p class="placeholder-note">Story coming next.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="ways" aria-labelledby="ways-heading">
        <div class="ways-inner">
          <h2 id="ways-heading" class="reveal">Inviting you to experience three ways of living and being</h2>

          <div class="ways-grid">
            <article class="way reveal">
              <p class="way-number">01</p>
              <h3>Nature-centric way of life</h3>
              <p>Here, land isn’t seen as a backdrop or resource. Land is family, elder, and teacher. They don’t ask “What can the land give me?”, they ask “How can the land and I take care of each other?”</p>
            </article>

            <article class="way reveal">
              <p class="way-number">02</p>
              <h3>Everything is connected</h3>
              <p>Life here is built on relationships. Relationships with family, neighbours, with rivers, forests, mountains. The whole is greater than the sum of the parts, 1+1=3.</p>
            </article>

            <article class="way reveal">
              <p class="way-number">03</p>
              <h3>Finding meaning, living purposefully</h3>
              <p>We will intentionally slow down to silence the noise within and around us, so that what really matters to us can be heard.</p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <script>
      const revealItems = document.querySelectorAll('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    background: #f4efe5;
    color: #18301f;
  }

  h1, h2, h3, blockquote, .brand, .person-name {
    font-family: Georgia, serif;
  }

  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 4%;
    color: white;
  }

  .brand {
    color: inherit;
    text-decoration: none;
    font-size: 1.3rem;
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .main-nav > a,
  summary {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .main-nav > a,
  summary,
  .story-link {
    transition: opacity 220ms ease;
  }

  .main-nav > a:hover,
  summary:hover,
  .story-link:hover {
    opacity: 0.72;
  }

  details { position: relative; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }

  .submenu {
    position: absolute;
    top: 1.7rem;
    right: 0;
    width: max-content;
    min-width: 12rem;
    padding: 0.7rem;
    background: rgba(244, 239, 229, 0.96);
    border-radius: 0.4rem;
    box-shadow: 0 12px 30px rgba(8, 20, 12, 0.18);
    transform-origin: top right;
    animation: menuReveal 180ms ease both;
  }

  .submenu a {
    display: block;
    padding: 0.65rem 0.75rem;
    color: #18301f;
    text-decoration: none;
    letter-spacing: 0;
    text-transform: none;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    color: white;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -2%;
    background: url('/hero-river.JPG') center / cover no-repeat;
    transform: scale(1.02);
    animation: heroZoom 14s ease-in-out infinite alternate;
    will-change: transform;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(8, 20, 12, 0.58) 0%, rgba(8, 20, 12, 0.22) 42%, rgba(8, 20, 12, 0.02) 68%);
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    top: 18%;
    left: 4%;
    z-index: 2;
    max-width: 92vw;
  }

  .hero-reveal {
    animation: heroReveal 1.1s cubic-bezier(.22,.61,.36,1) 120ms both;
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(3rem, 6vw, 6.5rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  .hero p {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.55;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    transform: translateX(-50%);
    color: white;
  }

  .scroll-label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    opacity: 0.9;
  }

  .scroll-line {
    display: block;
    width: 2px;
    height: 54px;
    background: rgba(255,255,255,0.34);
    overflow: hidden;
  }

  .scroll-line > span {
    display: block;
    width: 100%;
    height: 20px;
    background: rgba(255,255,255,0.98);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  .people {
    background: #f4efe5;
    padding: clamp(4.5rem, 9vw, 8rem) 4% clamp(5rem, 10vw, 9rem);
  }

  .people-inner {
    width: min(1280px, 100%);
    margin: 0 auto;
  }

  .people h2 {
    margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
    text-align: center;
    font-size: clamp(2.4rem, 4.4vw, 4.5rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .founders-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .founder-card { min-width: 0; }

  .portrait-wrap {
    overflow: hidden;
    border-radius: 0.25rem;
    background: #d8d1c3;
    aspect-ratio: 4 / 5;
  }

  .portrait-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 42%;
    transition: transform 900ms cubic-bezier(.22,.61,.36,1);
  }

  .founder-card:hover .portrait-wrap img {
    transform: scale(1.025);
  }

  .portrait-wrap--placeholder {
    background: rgba(24, 48, 31, 0.07);
    border: 1px solid rgba(24, 48, 31, 0.12);
  }

  .founder-copy { padding-top: 1.5rem; }

  .person-name {
    margin: 0 0 0.8rem;
    font-size: clamp(2.2rem, 3.6vw, 3.8rem);
    line-height: 1;
  }

  blockquote {
    margin: 0 0 1.5rem;
    max-width: none;
    font-size: clamp(1.35rem, 2.1vw, 2rem);
    font-weight: 400;
    line-height: 1.25;
  }

  .story-link {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    color: inherit;
    text-underline-offset: 0.35rem;
    font-size: 0.92rem;
  }

  .story-link span {
    display: inline-block;
    font-size: 1.45rem;
    line-height: 1;
    transition: transform 220ms ease;
  }

  .story-link:hover span {
    transform: translateX(5px);
  }

  .placeholder-note {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.62;
  }

  .ways {
    background: #18301f;
    color: #f4efe5;
    padding: clamp(5rem, 10vw, 9rem) 4%;
  }

  .ways-inner {
    width: min(1280px, 100%);
    margin: 0 auto;
  }

  .ways h2 {
    max-width: 20ch;
    margin: 0 auto clamp(3.5rem, 6vw, 5rem);
    text-align: center;
    font-size: clamp(2.4rem, 4.6vw, 4.8rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .ways-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(244, 239, 229, 0.25);
    border-bottom: 1px solid rgba(244, 239, 229, 0.25);
  }

  .way {
    padding: clamp(2rem, 4vw, 3.5rem);
  }

  .way + .way {
    border-left: 1px solid rgba(244, 239, 229, 0.25);
  }

  .way-number {
    margin: 0 0 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    opacity: 0.65;
  }

  .way h3 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.7rem, 2.5vw, 2.6rem);
    line-height: 1.1;
    font-weight: 400;
  }

  .way > p:last-child {
    margin: 0;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.7;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 800ms cubic-bezier(.22,.61,.36,1),
      transform 800ms cubic-bezier(.22,.61,.36,1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroZoom {
    from { transform: scale(1.02); }
    to { transform: scale(1.075); }
  }

  @keyframes scrollPulse {
    0% { transform: translateY(-22px); opacity: 0; }
    25% { opacity: 1; }
    75% { opacity: 1; }
    100% { transform: translateY(58px); opacity: 0; }
  }

  @keyframes menuReveal {
    from { opacity: 0; transform: translateY(-4px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      padding: 1.15rem 1.25rem;
    }

    .main-nav {
      gap: 0.75rem;
      font-size: 0.65rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .submenu { right: auto; left: 0; }

    .hero::before {
      background-position: 62% center;
      animation: heroZoomMobile 14s ease-in-out infinite alternate;
    }

    .overlay { background: linear-gradient(to bottom, rgba(8, 20, 12, 0.52) 0%, rgba(8, 20, 12, 0.16) 48%, rgba(8, 20, 12, 0.04) 72%); }

    .hero-content {
      top: 14%;
      left: 1.25rem;
      right: 1.25rem;
      max-width: none;
    }

    .hero h1 {
      font-size: clamp(2.65rem, 13vw, 4.5rem);
      white-space: normal;
    }

    .hero p {
      max-width: 28rem;
      font-size: 1.05rem;
    }

    .scroll-cue { bottom: 1rem; }
    .people { padding: 4.5rem 1.25rem 5rem; }

    .people h2 {
      margin-bottom: 2.75rem;
      font-size: clamp(2.2rem, 10vw, 3.4rem);
    }

    .founders-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .ways {
      padding: 4.5rem 1.25rem 5rem;
    }

    .ways h2 {
      font-size: clamp(2.2rem, 9vw, 3.4rem);
      margin-bottom: 2.75rem;
    }

    .ways-grid {
      grid-template-columns: 1fr;
    }

    .way {
      padding: 2rem 0;
    }

    .way + .way {
      border-left: 0;
      border-top: 1px solid rgba(244, 239, 229, 0.25);
    }
  }

  @keyframes heroZoomMobile {
    from { transform: scale(1.035); }
    to { transform: scale(1.09); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>
